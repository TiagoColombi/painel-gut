            "text/vcard",
            "text/x-vcard",
            "text/directory",
            ".vcf",
            "text/calendar",
            ".ics",
            "application/json",
            ".json",
            "text/plain",
            ".txt",
            ".eml"
          ]
        }
      ]
    }
  },
